# For Docker Compose only. Use dedicated values on any shared/production deployment.
POSTGRES_USER=fieldshift
POSTGRES_PASSWORD=fieldshift
POSTGRES_DB=fieldshift
INTERNAL_API_TOKEN=local-engine-token-change-before-deploy
# computed = real NASA data and agronomy; demo = clearly labelled fictional plans.
ENGINE_MODE=computed
ENABLE_NASA_POWER=true
CACHE_ENABLED=true
