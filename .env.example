# The only configuration file: copy to .env in the repository root.
# Placeholder credentials for new checkouts. Replace both before starting.
# Use URL-safe letters, numbers, underscores or hyphens for the database password.
POSTGRES_USER=croppilot
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=croppilot
INTERNAL_API_TOKEN=REPLACE_WITH_INTERNAL_TOKEN_AT_LEAST_32_CHARACTERS

# Real calculated recommendations; demo returns visibly fictional plans.
ENGINE_MODE=computed
ENABLE_NASA_POWER=true
HISTORY_YEARS=20
SOILGRIDS_TIMEOUT_S=8
DATA_DEADLINE_S=60
ENABLE_ENGINE_DOCS=false

# Native local development. Compose supplies container-to-container URLs itself.
ENGINE_URL=http://127.0.0.1:8000
ENGINE_TIMEOUT_MS=90000
CACHE_BACKEND_URL=http://127.0.0.1:3000
CACHE_ENABLED=true
NEXT_PUBLIC_USE_MOCK_API=false
# DATABASE_URL is derived from POSTGRES_* for native commands; Compose uses postgres:5432.
# Public download caches use services/engine/cache locally and /tmp/croppilot-cache in Docker.

# Optional English-only OpenAI summary. Add your server-side key here.
# The calculated recommendations work without an AI key.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-6-luna
AI_SUMMARY_ENABLED=true

# VPS HTTPS settings. Replace these when deploying to your own server.
DOMAIN=croppilot.example.com
ACME_EMAIL=you@example.com
