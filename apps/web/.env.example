# Local development only. Keep the same token in services/engine/.env.
ENGINE_URL=http://localhost:8000
INTERNAL_API_TOKEN=local-engine-token-change-before-deploy
ENGINE_TIMEOUT_MS=90000
# Optional public-data cache. No user profiles or submitted analyses are stored.
CACHE_ENABLED=false
DATABASE_URL=postgresql://fieldshift:fieldshift@localhost:5432/fieldshift
# Frontend-only development: true uses a visibly labelled fictional fixture.
NEXT_PUBLIC_USE_MOCK_API=false
# Optional AI summary of computed results (server-side only, never sent to the browser).
# Leave empty to hide it: the page then says the summary is not set up.
ANTHROPIC_API_KEY=
AI_SUMMARY_ENABLED=true
