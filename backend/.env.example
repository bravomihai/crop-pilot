# Copy to .env.local
# Python engine base URL. Empty = mock mode: return contracts/examples/analysis-result.example.json
ENGINE_URL=
# Where the contracts folder is (examples are used in mock mode)
CONTRACTS_DIR=../contracts
# Public URL of the React app, used in SMS links and CORS
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# SMS / WhatsApp provider (see infra/README.md). Used to verify webhook signatures.
TWILIO_AUTH_TOKEN=
