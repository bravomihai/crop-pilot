{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/crop-rules.schema.json",
  "title": "CropRules",
  "description": "Agronomic knowledge for one region: crop traits, rotation rules and the successor matrix. Owned by the evaluator (P3). Every value must point to a source.",
  "type": "object",
  "required": ["region", "version", "crops", "successor", "rules", "sources"],
  "additionalProperties": false,
  "properties": {
    "region": { "type": "string", "examples": ["ro-south"] },
    "version": { "type": "string" },
    "crops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "family", "season", "sowing_month", "harvest_month", "ecocrop", "kc", "season_days", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/cropId" },
          "name": {
            "type": "object",
            "required": ["ro", "en"],
            "properties": { "ro": { "type": "string" }, "en": { "type": "string" } }
          },
          "family": { "description": "Botanical family, used for pest/disease intervals.", "type": "string", "examples": ["poaceae", "fabaceae", "brassicaceae", "asteraceae"] },
          "role": { "type": "string", "enum": ["cash", "cover", "forage"], "default": "cash" },
          "season": { "type": "string", "enum": ["winter", "spring", "summer"] },
          "sowing_month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "harvest_month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "season_days": { "type": "integer", "minimum": 30, "maximum": 400 },
          "ecocrop": {
            "description": "FAO EcoCrop ranges. Optimal range inside absolute range.",
            "type": "object",
            "required": ["tmin", "topt_min", "topt_max", "tmax", "rain_min", "rain_opt_min", "rain_opt_max", "rain_max"],
            "additionalProperties": false,
            "properties": {
              "tmin": { "type": "number" }, "topt_min": { "type": "number" }, "topt_max": { "type": "number" }, "tmax": { "type": "number" },
              "rain_min": { "type": "number" }, "rain_opt_min": { "type": "number" }, "rain_opt_max": { "type": "number" }, "rain_max": { "type": "number" },
              "ph_min": { "type": "number" }, "ph_max": { "type": "number" },
              "killing_temp_c": { "type": ["number", "null"] }
            }
          },
          "kc": {
            "description": "FAO-56 crop coefficients.",
            "type": "object",
            "required": ["ini", "mid", "end"],
            "additionalProperties": false,
            "properties": { "ini": { "type": "number" }, "mid": { "type": "number" }, "end": { "type": "number" } }
          },
          "root_depth_m": { "type": "number", "minimum": 0 },
          "n_fixing": { "type": "boolean", "default": false },
          "residue": { "type": "string", "enum": ["low", "medium", "high"] },
          "drought_tolerance": { "type": "string", "enum": ["low", "medium", "high"] },
          "forage_value": { "$ref": "common.schema.json#/$defs/score" },
          "gaez_crop_code": { "description": "Code used to look up the GAEZ v4 attainable-yield raster.", "type": "string" },
          "equipment": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourceRef" } }
        }
      }
    },
    "successor": {
      "description": "Previous crop x next crop value. Missing pairs = unknown, not neutral.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["previous", "next", "value", "source"],
        "additionalProperties": false,
        "properties": {
          "previous": { "$ref": "common.schema.json#/$defs/cropId" },
          "next": { "$ref": "common.schema.json#/$defs/cropId" },
          "value": { "$ref": "common.schema.json#/$defs/score" },
          "note": { "type": "string" },
          "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
        }
      }
    },
    "rules": {
      "description": "Hard filters. A rotation violating any rule is not proposed (the existing rotation is still shown, with the violation listed).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "message", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["min_return_years", "family_min_return_years", "forbidden_successor", "max_share"]
          },
          "crop": { "$ref": "common.schema.json#/$defs/cropId" },
          "family": { "type": "string" },
          "previous": { "$ref": "common.schema.json#/$defs/cropId" },
          "next": { "$ref": "common.schema.json#/$defs/cropId" },
          "years": { "type": "integer", "minimum": 1 },
          "max_share": { "type": "number", "minimum": 0, "maximum": 1 },
          "message": {
            "type": "object",
            "required": ["ro", "en"],
            "properties": { "ro": { "type": "string" }, "en": { "type": "string" } }
          },
          "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
