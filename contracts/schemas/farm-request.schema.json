{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/farm-request.schema.json",
  "title": "FarmRequest",
  "description": "Everything the farmer provides. Produced by the frontend form (P1) or the SMS flow, stored by the backend (P5), consumed by the engine (P2, P4).",
  "type": "object",
  "required": ["field", "history", "current_rotation", "priorities", "scenario"],
  "additionalProperties": false,
  "properties": {
    "farm_id": {
      "description": "Assigned by the backend when the farm is saved. Absent on first submit.",
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": ["ro", "en"],
      "default": "ro"
    },
    "contact": {
      "description": "Optional, only for the SMS / WhatsApp channel.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone_e164": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" },
        "channel": { "type": "string", "enum": ["sms", "whatsapp"] }
      }
    },
    "field": {
      "type": "object",
      "required": ["boundary", "irrigated"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "boundary": {
          "description": "GeoJSON Polygon, WGS84, [lon, lat] order.",
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number" }
                }
              }
            }
          }
        },
        "area_ha": {
          "description": "Computed by the frontend from the boundary; the backend may recompute it.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "irrigated": { "type": "boolean" }
      }
    },
    "history": {
      "type": "object",
      "required": ["source", "seasons"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Where the crop history came from. Confidence drops from apia to none.",
          "type": "string",
          "enum": ["apia", "spray_records", "typed", "satellite", "none"]
        },
        "confirmed_by_farmer": { "type": "boolean", "default": false },
        "seasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year", "crop"],
            "additionalProperties": false,
            "properties": {
              "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
              "crop": { "$ref": "common.schema.json#/$defs/cropId" },
              "yield_t_ha": { "type": "number", "minimum": 0 },
              "cover_crop_after": { "$ref": "common.schema.json#/$defs/cropId" }
            }
          }
        }
      }
    },
    "current_rotation": {
      "description": "The farmer's existing rotation, repeated cyclically. Always evaluated as the baseline strategy.",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "common.schema.json#/$defs/cropId" }
    },
    "priorities": {
      "description": "Relative weights per criterion (any non-negative numbers; the engine normalises them). Missing criteria get weight 0.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/criterion" },
      "additionalProperties": { "type": "number", "minimum": 0 },
      "minProperties": 1
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excluded_crops": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/cropId" }
        },
        "market_crops": {
          "description": "Crops the farmer can sell locally. Used by the income criterion.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/cropId" }
        },
        "equipment": {
          "description": "Free tags, matched against CropRules.crops[].equipment.",
          "type": "array",
          "items": { "type": "string" },
          "examples": [["cereal_drill", "row_planter", "combine"]]
        },
        "max_irrigation_mm": {
          "type": "number",
          "minimum": 0
        },
        "allow_cover_crops": { "type": "boolean", "default": true }
      }
    },
    "rotation_years": {
      "description": "Length of the alternative rotations to generate.",
      "type": "integer",
      "minimum": 2,
      "maximum": 5,
      "default": 3
    },
    "scenario": { "$ref": "common.schema.json#/$defs/scenario" }
  }
}
