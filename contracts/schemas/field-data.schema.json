{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldshift.local/schemas/field-data.schema.json",
  "title": "FieldData",
  "description": "Crop-independent environmental data for one field, per year. Produced by the data service (P2), consumed by the evaluator (P3). Crop-specific calculations (water deficit, suitability) do NOT belong here.",
  "type": "object",
  "required": ["location", "period", "sources", "years"],
  "additionalProperties": false,
  "$defs": {
    "monthly12": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": ["number", "null"] }
    }
  },
  "properties": {
    "location": {
      "description": "Field centroid, WGS84.",
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "period": {
      "type": "object",
      "required": ["start_year", "end_year"],
      "additionalProperties": false,
      "properties": {
        "start_year": { "type": "integer" },
        "end_year": { "type": "integer" }
      }
    },
    "sources": {
      "description": "Every dataset used. Indicators reference these ids.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dataset", "retrieved_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "examples": ["nasa_power", "smap_l4", "srtm", "soilgrids", "cmip6"] },
          "dataset": { "type": "string" },
          "resolution": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "from_cache": { "type": "boolean" }
        }
      }
    },
    "static": {
      "description": "Field properties that do not change per year.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elevation_m": { "type": "number" },
        "slope_pct": { "type": "number", "minimum": 0 },
        "soil": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ph": { "type": "number", "minimum": 0, "maximum": 14 },
            "texture": { "type": "string", "examples": ["clay_loam", "silt_loam", "sandy_loam"] },
            "organic_carbon_pct": { "type": "number", "minimum": 0 },
            "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
          }
        },
        "groundwater_trend_mm_yr": {
          "description": "GRACE / GRACE-FO regional trend. Very coarse; context only.",
          "type": "number"
        }
      }
    },
    "years": {
      "description": "One entry per observed year. The evaluator replays rotations over these years.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["year", "monthly"],
        "additionalProperties": false,
        "properties": {
          "year": { "type": "integer" },
          "precip_mm": { "type": "number", "minimum": 0 },
          "et0_mm": { "description": "Reference evapotranspiration (FAO-56).", "type": "number", "minimum": 0 },
          "gdd_base10": { "description": "Growing degree days, base 10 °C.", "type": "number", "minimum": 0 },
          "frost_days": { "description": "Days with Tmin < 0 °C.", "type": "integer", "minimum": 0 },
          "last_spring_frost_doy": { "type": ["integer", "null"], "minimum": 1, "maximum": 366 },
          "first_autumn_frost_doy": { "type": ["integer", "null"], "minimum": 1, "maximum": 366 },
          "heat_days_gt32": { "description": "Days with Tmax > 32 °C.", "type": "integer", "minimum": 0 },
          "heavy_rain_days_gt20mm": { "type": "integer", "minimum": 0 },
          "soil_moisture_rootzone": { "description": "Mean root-zone soil moisture, m3/m3 (SMAP L4).", "type": ["number", "null"] },
          "monthly": {
            "type": "object",
            "required": ["precip_mm", "et0_mm", "tmean_c"],
            "additionalProperties": false,
            "properties": {
              "precip_mm": { "$ref": "#/$defs/monthly12" },
              "et0_mm": { "$ref": "#/$defs/monthly12" },
              "tmean_c": { "$ref": "#/$defs/monthly12" },
              "tmin_c": { "$ref": "#/$defs/monthly12" },
              "tmax_c": { "$ref": "#/$defs/monthly12" },
              "ndvi": { "description": "Field mean NDVI (Sentinel-2 / Landsat), null where no clear image.", "$ref": "#/$defs/monthly12" }
            }
          }
        }
      }
    },
    "scenario_deltas": {
      "description": "NEX-GDDP-CMIP6 change vs the observed period, applied by the evaluator (delta method). Key format: <ssp>_<horizon>.",
      "type": "object",
      "propertyNames": { "pattern": "^ssp(245|585)_(2030|2050)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["temp_change_c", "precip_change_pct"],
        "additionalProperties": false,
        "properties": {
          "temp_change_c": { "type": "number" },
          "precip_change_pct": { "type": "number" },
          "n_models": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
