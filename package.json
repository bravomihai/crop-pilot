{
  "name": "fieldshift",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @fieldshift/web dev",
    "build": "pnpm contracts:generate && pnpm --filter @fieldshift/web build",
    "typecheck": "pnpm --filter @fieldshift/contracts typecheck && pnpm --filter @fieldshift/web typecheck",
    "contracts:generate": "pnpm --filter @fieldshift/contracts generate",
    "db:generate": "pnpm --filter @fieldshift/web db:generate",
    "db:migrate": "pnpm --filter @fieldshift/web db:migrate",
    "db:deploy": "pnpm --filter @fieldshift/web db:deploy"
  }
}
