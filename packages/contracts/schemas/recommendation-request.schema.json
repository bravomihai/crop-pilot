{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "location": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "field_boundary": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Polygon"
        },
        "coordinates": {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "minItems": 4,
            "maxItems": 101,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "available_from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "crop_count": {
      "default": 3,
      "type": "number",
      "const": 3
    },
    "history": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "crop_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "harvest_year": {
            "type": "integer",
            "minimum": 1950,
            "maximum": 2150
          },
          "source": {
            "type": "string",
            "enum": [
              "typed",
              "apia",
              "spray_records",
              "satellite",
              "unknown"
            ]
          }
        },
        "required": [
          "crop_id"
        ],
        "additionalProperties": false
      }
    },
    "assessment_crops": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "preferred_crop": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "current_rotation": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "money_inputs": {
      "type": "object",
      "properties": {
        "prices_lei_per_t": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          }
        },
        "costs_lei_per_ha": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          }
        }
      },
      "additionalProperties": false
    },
    "soil": {
      "type": "object",
      "properties": {
        "texture": {
          "type": "string",
          "enum": [
            "sandy",
            "loamy",
            "clay",
            "silty",
            "unknown"
          ]
        },
        "ph": {
          "type": "number",
          "minimum": 0,
          "maximum": 14
        },
        "organic_carbon_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "source": {
          "default": "unknown",
          "type": "string",
          "enum": [
            "farmer_estimate",
            "lab",
            "unknown"
          ]
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "priorities": {
      "type": "object",
      "properties": {
        "water": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "soil": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "climate": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "productivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "water",
        "soil",
        "climate"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "irrigated": {
          "default": false,
          "type": "boolean"
        },
        "max_irrigation_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "excluded_crops": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "selected_crops": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "selected_crops_only": {
          "type": "boolean"
        }
      },
      "required": [
        "irrigated",
        "excluded_crops"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "temp_change_c": {
          "default": 0,
          "type": "number",
          "minimum": -3,
          "maximum": 5
        },
        "rain_change_pct": {
          "default": 0,
          "type": "number",
          "minimum": -50,
          "maximum": 50
        }
      },
      "required": [
        "temp_change_c",
        "rain_change_pct"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "location",
    "available_from",
    "crop_count",
    "history",
    "priorities",
    "constraints",
    "scenario"
  ],
  "additionalProperties": false
}
