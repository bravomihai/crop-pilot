INTERNAL_API_TOKEN=local-engine-token-change-before-deploy
# computed runs the real engine on live NASA data (needs ENABLE_NASA_POWER=true).
# demo returns clearly labelled fictional plans, for frontend work without internet.
ENGINE_MODE=computed
ENABLE_NASA_POWER=true
HISTORY_YEARS=20
# Local disk cache for public NASA/SoilGrids/SRTM downloads (relative to services/engine; git-ignored).
FIELDSHIFT_CACHE_DIR=cache
# Seconds to wait for SoilGrids before reporting soil as a data gap.
SOILGRIDS_TIMEOUT_S=8
# Overall seconds for the parallel NASA POWER / SoilGrids / SRTM downloads. Keep it below the
# web app's ENGINE_TIMEOUT_MS (90 s) minus evaluation time (up to ~16 s).
DATA_DEADLINE_S=60
# Optional public-data cache through Next.js. No direct Python access to application tables.
CACHE_BACKEND_URL=http://localhost:3000
ENABLE_ENGINE_DOCS=false
