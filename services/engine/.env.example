INTERNAL_API_TOKEN=local-engine-token-change-before-deploy
# demo returns explicitly fictional plans. computed is reserved for P2/P3/P4 implementation.
ENGINE_MODE=demo
ENABLE_NASA_POWER=false
HISTORY_YEARS=20
# Optional public-data cache through Next.js. No direct Python access to application tables.
CACHE_BACKEND_URL=http://localhost:3000
ENABLE_ENGINE_DOCS=false
