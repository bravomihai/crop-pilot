  "local_checks": {
    "sunflower": "Check the field's broomrape (Orobanche cumana) history and choose a resistant sunflower hybrid.",
    "winter_rapeseed": "Check residual herbicides from the previous crop before sowing rapeseed, and seedbed moisture at the end of August.",
    "maize": "Check for western corn rootworm (Diabrotica) if maize was grown on this field in the previous two years.",
    "soybean": "Check that the soybean maturity group fits the area and that seed is inoculated if soybean is new on the field.",
    "pea": "Check pea root-disease history; keep at least four years between pea crops.",
    "winter_wheat": "Check Fusarium risk and residue management if wheat follows maize.",
    "winter_barley": "Check winter hardiness of the barley variety for this area.",
    "oats": "Confirm the spring-oat variety and sowing window; check whether cereal disease history makes a small-grain successor unsuitable.",
    "sorghum": "Confirm the grain-sorghum hybrid's maturity and harvest moisture requirements for the local area.",
    "dry_beans": "Check bean root-disease history, harvest conditions, and inoculation needs; keep legumes apart in the rotation.",
    "sugar_beet": "Confirm local sugar-beet processor access, contract requirements, and soil compaction risk.",
